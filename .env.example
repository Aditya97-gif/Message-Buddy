# Copy this file to .env and fill in your values.
# Never commit .env to git.

# --- Google Gemini backend (optional if using Ollama) ---
# Get a free key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# --- Backend selection ---
# "auto"   → try Ollama first, fall back to Google (default)
# "ollama" → force Ollama (local, no API key needed)
# "google" → force Google Gemini (requires GOOGLE_API_KEY)
LLM_BACKEND=auto

# --- Ollama overrides (optional) ---
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_TEXT_MODEL=llama3.2
# OLLAMA_VISION_MODEL=llava:7b
